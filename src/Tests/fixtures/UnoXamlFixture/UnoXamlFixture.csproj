<Project Sdk="Uno.Sdk">
	<PropertyGroup>
		<!-- Deliberately minimal and single-TFM: this fixture exists to drive a real
		     MSBuild evaluation for language-service integration tests, not to be a
		     representative Uno app - net10.0-desktop matches what UnoDevelop itself
		     builds and runs in this environment, avoiding the mobile/browser
		     workloads a multi-TFM Uno project would otherwise require. -->
		<TargetFramework>net10.0-desktop</TargetFramework>
		<OutputType>Exe</OutputType>
		<UnoSingleProject>true</UnoSingleProject>
		<AssemblyName>UnoXamlFixture</AssemblyName>
		<RootNamespace>UnoXamlFixture</RootNamespace>
		<ApplicationTitle>UnoXamlFixture</ApplicationTitle>
		<ApplicationId>com.lextudio.unoxamlfixture</ApplicationId>
		<NoWarn>$(NoWarn);CS8632</NoWarn>
	</PropertyGroup>
</Project>
