<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Migrated to xUnit.net v3 / Microsoft.Testing.Platform (MTP) - TestService/DotNetTestRunner
    only speak MTP's server-mode protocol (server-mode client-host/client-port flags), not classic
    VSTest. As a VSTest/xunit v2 project this fixture could never actually be discovered: the MTP
    host would never connect back, DotNetTestRunner would eat the full 30s AcceptTcpClientAsync
    timeout on every single call, and TestService.GetTests() (a separate bug, now fixed) never
    cached the resulting empty list either - compounding into what looked like an indefinite hang
    across TestPanelTests. See SampleXunitMtpTests for the reference MTP fixture shape.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- No central package management — this fixture lives outside the main src tree. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <UnoDevelop_TestProperty></UnoDevelop_TestProperty>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="1.0.1" />
  </ItemGroup>
</Project>