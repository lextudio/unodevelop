<AddIn name="VB Binding"
       author="Siegfried Pamper"
       copyright="prj:///doc/copyright.txt"
       description="Backend binding for VB"
       addInManagerHidden="preinstalled">

    <Manifest>
        <Identity name="ICSharpCode.VBBinding"/>
    </Manifest>

    <Runtime>
        <Import assembly="ICSharpCode.VBBinding.dll"/>
        <Import assembly=":ICSharpCode.SharpDevelop"/>
    </Runtime>

    <Path name="/SharpDevelop/Workbench/Combine/FileFilter">
        <FileFilter id="VBProject" insertbefore="AllFiles" name="VB Project Files (*.vbproj)" class="ICSharpCode.SharpDevelop.Project.LoadProject" extensions="*.vbproj"/>
    </Path>

    <Path name="/SharpDevelop/MSBuildEngine/CompileTaskNames">
        <String id="vbc" text="vbc"/>
    </Path>

    <Path name="/SharpDevelop/MSBuildEngine/LoggerFilters">
        <TaskBoundLoggerFilter id="VbcEncodingFixingLogger" taskname="vbc" class="ICSharpCode.VBBinding.VbcEncodingFixingLogger"/>
    </Path>

    <Path name="/SharpDevelop/Workbench/ProjectBindings">
        <ProjectBinding id="VB" guid="{F184B08F-C81C-45F6-A57F-5ABD9991F28F}" supportedextensions=".vb" projectfileextension=".vbproj" class="ICSharpCode.VBBinding.VBProjectBinding"/>
    </Path>
</AddIn>
