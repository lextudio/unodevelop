<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <AssemblyName>UnoDevelop.UnitTesting</AssemblyName>
    <RootNamespace>UnoDevelop.UnitTesting</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Pad/*.cs" />
    <!-- Everything below is OpenDevelop's classic ICSharpCode.UnitTesting - the single, shared
         ITestFramework/ITestSolution/ITest tree backend (see doc/technotes/unit-testing.md).
         Confirmed WPF-free except Model/ITest.cs+TestBase.cs (ITest.GoToDefinition's
         System.Windows.Input.ICommand - a portable BCL interface, not WPF-specific; already used
         natively elsewhere in this codebase) and Service/SDTestService.cs
         (CommandManager.InvalidateRequerySuggested - confirmed to compile fine under Uno.Sdk too).
         Deliberately NOT linked: Commands/*.cs (WPF menu-command classes for OpenDevelop's own
         UnitTestsPad UI - UnoDevelop drives everything through DevFlow actions instead),
         TestRunner/TestProcessRunnerBase.cs/TestRunnerBase.cs/TestResultsReader.cs (the old
         VsTest-console-output-scraping runners MtpTestRunner replaced - unused by the Mtp path),
         MtpTestDebugger.cs/TestRunner/TestDebuggerBase.cs ("run under debugger" - UnoDevelop's
         test panel never exposed that option even under the old flat contract; not a regression). -->
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/Mtp/*.cs" Link="Mtp/%(Filename)%(Extension)" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/Model/*.cs" Link="Model/%(Filename)%(Extension)" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/Service/*.cs" Link="Service/%(Filename)%(Extension)" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/Interfaces/*.cs" Link="Interfaces/%(Filename)%(Extension)" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/ImmutableStack.cs" Link="ImmutableStack.cs" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/MultiDictionary.cs" Link="MultiDictionary.cs" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/MtpTestFramework.cs" Link="MtpTestFramework.cs" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/MtpTestProject.cs" Link="MtpTestProject.cs" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/MtpTestRunner.cs" Link="MtpTestRunner.cs" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/TestRunner/ITestRunner.cs" Link="TestRunner/ITestRunner.cs" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/TestRunner/TestExecutionManager.cs" Link="TestRunner/TestExecutionManager.cs" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/TestRunner/TestExecutionOptions.cs" Link="TestRunner/TestExecutionOptions.cs" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/TestRunner/TestFinishedEventArgs.cs" Link="TestRunner/TestFinishedEventArgs.cs" />
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/TestRunner/TestResultTask.cs" Link="TestRunner/TestResultTask.cs" />
    <!-- RoslynTestScanner.cs: shared fast-path scanner (see doc/technotes/unit-testing.md
         "Roslyn-assisted discovery"), used by MtpTestProject's tree seeding. -->
    <Compile Include="$(SharpDevelopSourceRoot)/src/AddIns/Analysis/UnitTesting/Simple/RoslynTestScanner.cs" Link="Simple/RoslynTestScanner.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnoDevelop.Core.Tests" />
    <!-- ServiceBootstrapper.cs (assembly "UnoDevelop") constructs SDTestService directly - it's
         internal (default visibility, matching OpenDevelop's own declaration) rather than public
         since only the bootstrapper should ever construct one. -->
    <InternalsVisibleTo Include="UnoDevelop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="UnitTesting.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
