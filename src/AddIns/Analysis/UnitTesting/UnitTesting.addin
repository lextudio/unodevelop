<AddIn name="UnoDevelop UnitTesting"
       author="OpenAI"
       description="Unit test integration for UnoDevelop">

  <Manifest>
    <Identity name="UnoDevelop.UnitTesting"/>
    <Dependency addin="SharpDevelop"/>
  </Manifest>

  <Runtime>
    <Import assembly="UnoDevelop.UnitTesting.dll" />
  </Runtime>
</AddIn>
