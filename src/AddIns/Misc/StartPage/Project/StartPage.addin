<AddIn name="Start Page"
       author="LeXtudio"
       copyright="MIT"
       url="https://github.com/lextudio/SharpDevelop"
       description="Welcome / start page shown when no solution is loaded."
       addInManagerHidden="preinstalled">
	
	<Manifest>
		<Identity name="UnoDevelop.StartPage" />
		<Dependency addin="ICSharpCode.SharpDevelop" />
	</Manifest>
	
	<Runtime>
		<Import assembly="UnoDevelop.StartPage.dll" />
	</Runtime>
	
	<!-- Autostart when no solution is loaded -->
	<Path name="/SharpDevelop/Workbench/AutostartNothingLoaded">
		<Class id="ShowStartPageCommand"
		       class="UnoDevelop.StartPage.ShowStartPageCommand" />
	</Path>
	
	<!-- Window > Start Page menu - UnoDevelop's own main menu bar (MainPage.SolutionExplorer.cs's
	     PopulateAddInMenu) builds from /UnoDevelop/MainMenu/*, not OpenDevelop's
	     /SharpDevelop/Workbench/MainMenu/* paths, and has no "View" menu (only File/Edit/Project/
	     Build/Debug/Search/Tools/Window/Help) - registering under the Window menu here, in this
	     addin's own file, so its <Runtime> import of UnoDevelop.StartPage.dll can actually resolve
	     the class (a copy previously lived in Shell.addin instead, whose <Runtime> only imports
	     ":UnoDevelop" and had no way to resolve a type from this separate addin assembly). -->
	<Path name="/UnoDevelop/MainMenu/Window">
		<MenuItem id="ShowStartPage"
		          label="Start Page"
		          class="UnoDevelop.StartPage.ShowStartPageCommand" />
	</Path>
	
	<!-- Items displayed on the StartPage -->
	<Path name="/SharpDevelop/ViewContent/StartPage/Items">
		<Class id="RecentProjects" class="UnoDevelop.StartPage.StartPageViewContent" />
	</Path>
</AddIn>
