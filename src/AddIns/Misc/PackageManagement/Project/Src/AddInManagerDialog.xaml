<ContentDialog
    x:Class="UnoDevelop.AddIns.AddInManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Extensions"
    PrimaryButtonText="Close">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">500</x:Double>

    <DataTemplate x:Key="AddInItemTemplate">
      <Grid Padding="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="{Binding DisplayName}"
                     FontWeight="Bold" />
          <TextBlock Text="{Binding Version}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     FontSize="12" />
          <TextBlock Text="{Binding Author}"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                     FontSize="11" />
          <TextBlock Text="{Binding Status}"
                     FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="4"
                    Margin="8,0,0,0">
          <Button Content="{Binding ToggleLabel}"
                  Tag="{Binding}"
                  Click="OnToggleAddIn" />
          <Button Content="Remove"
                  Tag="{Binding}"
                  IsEnabled="{Binding IsExternalOrUser}"
                  Click="OnRemoveAddIn" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ExtensionItemTemplate">
      <Grid Padding="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="{Binding DisplayName}"
                     FontWeight="Bold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Version}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="12" />
            <TextBlock Text="{Binding Publisher}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="12" />
            <TextBlock Text="{Binding KindLabel}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="12" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding GrammarCountLabel}"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding ThemeCountLabel}"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding ServerCountLabel}"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1"
                Content="Uninstall"
                Tag="{Binding}"
                Click="OnUninstallExtension"
                VerticalAlignment="Center"
                Margin="8,0,0,0" />
      </Grid>
    </DataTemplate>
  </ContentDialog.Resources>

  <Grid Width="500" Height="450">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Spacing="8"
                Margin="4,4,4,4">
      <Button x:Name="_installButton"
              Content="Install from file..."
              Click="OnInstallFromFile" />
    </StackPanel>

    <TabView Grid.Row="1"
             Margin="4,0,4,0"
             IsAddTabButtonVisible="False">
      <TabViewItem Header="Built-in AddIns">
        <ListView x:Name="_builtInAddInList"
                  SelectionMode="Single"
                  ItemTemplate="{StaticResource AddInItemTemplate}" />
      </TabViewItem>

      <TabViewItem Header="User / External AddIns">
        <ListView x:Name="_externalAddInList"
                  SelectionMode="Single"
                  ItemTemplate="{StaticResource AddInItemTemplate}" />
      </TabViewItem>

      <TabViewItem Header="Language Extensions (VSIX)">
        <ListView x:Name="_extensionList"
                  SelectionMode="Single"
                  ItemTemplate="{StaticResource ExtensionItemTemplate}" />
      </TabViewItem>
    </TabView>

    <TextBlock x:Name="_statusText"
               Grid.Row="2"
               Margin="4,4,0,0"
               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
  </Grid>
</ContentDialog>
