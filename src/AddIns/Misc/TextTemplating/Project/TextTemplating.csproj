<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>UnoDevelop.TextTemplating</AssemblyName>
    <RootNamespace>UnoDevelop.TextTemplating</RootNamespace>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(SharpDevelopSourceRoot)\src\AddIns\Misc\TextTemplating\Project\Src\**\*.cs"
             Link="Upstream\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="Src\TextTemplatingStartup.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" />
    <ProjectReference Include="..\..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.TextTemplating" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\TextTemplating.xshd">
      <LogicalName>UnoDevelop.TextTemplating.Resources.TextTemplating.xshd</LogicalName>
    </EmbeddedResource>
    <None Include="TextTemplating.addin" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
