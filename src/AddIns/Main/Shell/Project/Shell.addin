<AddIn name="UnoDevelop Shell"
       author="OpenAI"
       description="Shell menus backed by AddInTree commands">
  <Manifest>
    <Identity name="UnoDevelop.Shell" version="1.0"/>
  </Manifest>

  <Runtime>
    <Import assembly=":UnoDevelop">
      <ConditionEvaluator name="ExecutionActive" class="UnoDevelop.Services.ExecutionActiveConditionEvaluator" />
      <ConditionEvaluator name="Debugging" class="UnoDevelop.Services.DebuggingConditionEvaluator" />
      <ConditionEvaluator name="Paused" class="UnoDevelop.Services.PausedConditionEvaluator" />
      <ConditionEvaluator name="TestsRunning" class="UnoDevelop.Services.TestsRunningConditionEvaluator" />
      <ConditionEvaluator name="ProjectActive" class="UnoDevelop.Conditions.ProjectActiveConditionEvaluator" />
      <ConditionEvaluator name="WindowActive" class="UnoDevelop.Conditions.WindowActiveConditionEvaluator" />
      <ConditionEvaluator name="ActiveWindowState" class="UnoDevelop.Conditions.ActiveWindowStateConditionEvaluator" />
      <ConditionEvaluator name="OpenWindowState" class="UnoDevelop.Conditions.OpenWindowStateConditionEvaluator" />
      <ConditionEvaluator name="CanNavigateBack" class="UnoDevelop.Conditions.CanNavigateBackConditionEvaluator" />
      <ConditionEvaluator name="CanNavigateForward" class="UnoDevelop.Conditions.CanNavigateForwardConditionEvaluator" />
    </Import>
  </Runtime>

  <Path name="/SharpDevelop/Workbench/Pads">
    <Pad id="Toolbox"
         class="UnoDevelop.Workbench.ToolboxPad"
         title="Toolbox"
         category="Main"
         defaultPosition="Left" />
    <Pad id="Outline"
         class="UnoDevelop.Workbench.OutlinePad"
         title="Outline"
         category="Main"
         defaultPosition="Left, Hidden" />
  </Path>

  <Path name="/UnoDevelop/MainMenu/File">
    <MenuItem id="OpenSolutionOrProject" label="Open Solution or Project..." class="UnoDevelop.Commands.OpenSolutionOrProjectShellCommand" />
    <MenuItem id="CloseSolution" label="Close Solution" class="UnoDevelop.Commands.CloseSolutionShellCommand" />
    <MenuItem id="Separator0" type="Separator" />
    <MenuItem id="Exit" label="Exit" class="UnoDevelop.Commands.ExitShellCommand" />
  </Path>

  <Path name="/UnoDevelop/MainMenu/Edit">
  </Path>

  <Path name="/UnoDevelop/MainMenu/Project">
  </Path>

  <Path name="/UnoDevelop/MainMenu/Build">
    <MenuItem id="BuildSolution" label="Build Solution" class="UnoDevelop.Commands.BuildSolutionShellCommand" />
    <MenuItem id="CancelBuild" label="Cancel Build" class="UnoDevelop.Commands.CancelBuildShellCommand" />
    <MenuItem id="Separator0" type="Separator" />
    <MenuItem id="RefreshTests" label="Refresh Tests" icon="Refresh_16x" class="UnoDevelop.Commands.RefreshTestsShellCommand" />
    <MenuItem id="RunAllTests" label="Run All Tests" icon="RunTest_16x" class="UnoDevelop.Commands.RunAllTestsShellCommand" />
    <MenuItem id="StopTests" label="Stop Tests" icon="Stop_16x" class="UnoDevelop.Commands.StopTestsShellCommand" />
  </Path>

  <Path name="/UnoDevelop/MainMenu/Debug">
    <MenuItem id="RunWithoutDebugging" label="Run (without debugging)" class="UnoDevelop.Commands.RunWithoutDebuggingShellCommand" />
    <MenuItem id="Stop" label="Stop" class="UnoDevelop.Commands.StopRunShellCommand" />
    <MenuItem id="Separator0" type="Separator" />
    <MenuItem id="Debug" label="Debug" class="UnoDevelop.Commands.DebugShellCommand" />
    <MenuItem id="Separator1" type="Separator" />
    <MenuItem id="Continue" label="Continue" class="UnoDevelop.Commands.ContinueDebugShellCommand" />
    <MenuItem id="StepOver" label="Step Over" class="UnoDevelop.Commands.StepOverDebugShellCommand" />
    <MenuItem id="StepInto" label="Step Into" class="UnoDevelop.Commands.StepIntoDebugShellCommand" />
    <MenuItem id="StepOut" label="Step Out" class="UnoDevelop.Commands.StepOutDebugShellCommand" />
  </Path>

  <Path name="/UnoDevelop/MainMenu/Search">
  </Path>

  <Path name="/UnoDevelop/MainMenu/Analysis">
    <MenuItem id="RefreshTests" label="Refresh Tests" icon="Refresh_16x" class="UnoDevelop.Commands.RefreshTestsShellCommand" />
    <MenuItem id="RunAllTests" label="Run All Tests" icon="RunTest_16x" class="UnoDevelop.Commands.RunAllTestsShellCommand" />
    <MenuItem id="StopTests" label="Stop Tests" icon="Stop_16x" class="UnoDevelop.Commands.StopTestsShellCommand" />
  </Path>

  <Path name="/UnoDevelop/MainMenu/Tools">
    <MenuItem id="AddInManager" label="AddIn Manager" class="UnoDevelop.Commands.ShowAddInManagerCommand" />
    <MenuItem id="Separator0" type="Separator" />
    <MenuItem id="Options" label="Options" class="UnoDevelop.Commands.OptionsCommand" />
  </Path>

  <Path name="/UnoDevelop/MainMenu/Window">
    <MenuItem id="ShowStartPage" label="Start Page" class="UnoDevelop.StartPage.ShowStartPageCommand" />
  </Path>

  <Path name="/UnoDevelop/MainMenu/Help">
  </Path>

  <Path name="/SharpDevelop/Dialogs/OptionsDialog">
    <OptionPanel id="UIOptions" label="UI Options">
    </OptionPanel>
    <OptionPanel id="TextEditorOptions" label="Text Editor">
      <OptionPanel id="General" label="General"
                   class="UnoDevelop.OptionPanels.GeneralEditorOptions" />
      <OptionPanel id="Behavior" label="Behavior"
                   class="UnoDevelop.OptionPanels.BehaviorOptions" />
      <OptionPanel id="Markers" label="Markers"
                   class="UnoDevelop.OptionPanels.TextViewOptions" />
    </OptionPanel>
    <OptionPanel id="ToolsOptions" label="Tools">
    </OptionPanel>
  </Path>

  <Path name="/UnoDevelop/Workbench/ToolBar/Standard">
    <!-- File operations -->
    <ToolbarItem id="New" tooltip="New File" icon="NewFile_16x" class="UnoDevelop.Commands.NewFileShellCommand" />
    <ToolbarItem id="Open" tooltip="Open File" icon="OpenFile_16x" class="UnoDevelop.Commands.OpenFileShellCommand" />
    <ToolbarItem id="OpenProject" tooltip="Open Solution or Project" icon="OpenfileDialog_16x" class="UnoDevelop.Commands.OpenSolutionOrProjectShellCommand" />
    <Condition name="ActiveWindowState" windowstate="Dirty,Untitled" nowindowstate="ViewOnly" action="Disable">
      <ToolbarItem id="Save" tooltip="Save" icon="Save_16x" class="UnoDevelop.Commands.SaveFileShellCommand" />
    </Condition>
    <Condition name="OpenWindowState" openwindowstate="Dirty" action="Disable">
      <ToolbarItem id="SaveAll" tooltip="Save All" icon="SaveAll_16x" class="UnoDevelop.Commands.SaveAllShellCommand" />
    </Condition>
    <!-- Edit operations -->
    <ToolbarItem id="EditSeparator" type="Separator" />
    <ToolbarItem id="Cut" tooltip="Cut" icon="Cut_16x" class="UnoDevelop.Commands.CutShellCommand" />
    <ToolbarItem id="Copy" tooltip="Copy" icon="Copy_16x" class="UnoDevelop.Commands.CopyShellCommand" />
    <ToolbarItem id="Paste" tooltip="Paste" icon="Paste_16x" class="UnoDevelop.Commands.PasteShellCommand" />
    <ToolbarItem id="Delete" tooltip="Delete" icon="Cancel_16x" class="UnoDevelop.Commands.DeleteShellCommand" />
    <ToolbarItem id="UndoRedoSeparator" type="Separator" />
    <ToolbarItem id="Undo" tooltip="Undo" icon="Undo_16x" class="UnoDevelop.Commands.UndoShellCommand" />
    <ToolbarItem id="Redo" tooltip="Redo" icon="Redo_16x" class="UnoDevelop.Commands.RedoShellCommand" />
    <!-- Build operations -->
    <ToolbarItem id="BuildSeparator" type="Separator" />
    <Condition name="SolutionOpen" action="Disable">
      <ToolbarItem id="BuildSolution" tooltip="Build Solution" icon="BuildSolution_16x" class="UnoDevelop.Commands.BuildSolutionShellCommand" />
    </Condition>
    <Condition name="SolutionOpen" action="Disable">
      <Condition name="ProjectActive" action="Disable">
        <ToolbarItem id="BuildProject" tooltip="Build Project" icon="BuildSelection_16x" class="UnoDevelop.Commands.BuildProjectShellCommand" />
      </Condition>
    </Condition>
    <!-- Run / Debug -->
    <ToolbarItem id="DebugSeparator" type="Separator" />
    <Condition name="SolutionOpen" action="Disable">
      <Condition name="ExecutionActive" active="False" action="Disable">
        <ToolbarItem id="RunWithoutDebugging" tooltip="Run (without debugging)" icon="StartWithoutDebug_16x" class="UnoDevelop.Commands.RunWithoutDebuggingShellCommand" />
        <ToolbarItem id="Debug" tooltip="Debug" icon="Run_16x" class="UnoDevelop.Commands.DebugShellCommand" />
      </Condition>
    </Condition>
    <Condition name="ExecutionActive" active="True" action="Disable">
      <ToolbarItem id="Stop" tooltip="Stop" icon="Cancel_16x" class="UnoDevelop.Commands.StopRunShellCommand" />
    </Condition>
    <Condition name="Debugging" debugging="True" action="Disable">
      <Condition name="Paused" paused="True" action="Disable">
        <ToolbarItem id="Continue" tooltip="Continue (F5)" icon="StepForward_16x" class="UnoDevelop.Commands.ContinueDebugShellCommand" />
        <ToolbarItem id="StepOver" tooltip="Step Over (F10)" icon="StepOver_16x" class="UnoDevelop.Commands.StepOverDebugShellCommand" />
        <ToolbarItem id="StepInto" tooltip="Step Into (F11)" icon="StepIn_16x" class="UnoDevelop.Commands.StepIntoDebugShellCommand" />
        <ToolbarItem id="StepOut" tooltip="Step Out (Shift+F11)" icon="StepOut_16x" class="UnoDevelop.Commands.StepOutDebugShellCommand" />
      </Condition>
    </Condition>
    <!-- Navigation -->
    <ToolbarItem id="NavigationSeparator" type="Separator" />
    <Condition name="CanNavigateBack" action="Disable">
      <ToolbarItem id="NavigateBack" tooltip="Navigate Back" icon="Backward_16x" class="UnoDevelop.Commands.NavigateBackShellCommand" />
    </Condition>
    <Condition name="CanNavigateForward" action="Disable">
      <ToolbarItem id="NavigateForward" tooltip="Navigate Forward" icon="Forward_16x" class="UnoDevelop.Commands.NavigateForwardShellCommand" />
    </Condition>
    <!-- Editor tools -->
    <ToolbarItem id="SearchSeparator" type="Separator" />
    <Condition name="WindowActive" activewindow="ICSharpCode.SharpDevelop.Editor.ITextEditor" action="Disable">
      <ToolbarItem id="Comment" tooltip="Comment/Uncomment Selection" icon="CommentCode_16x" class="UnoDevelop.Commands.CommentRegionShellCommand" />
      <ToolbarItem id="SearchSeparator2" type="Separator" />
      <ToolbarItem id="ToggleBookmark" tooltip="Toggle Bookmark" icon="Bookmark_16x" class="UnoDevelop.Commands.ToggleBookmarkShellCommand" />
      <ToolbarItem id="PrevBookmark" tooltip="Previous Bookmark" icon="PreviousBookmark_16x" class="UnoDevelop.Commands.PrevBookmarkShellCommand" />
      <ToolbarItem id="NextBookmark" tooltip="Next Bookmark" icon="NextBookmark_16x" class="UnoDevelop.Commands.NextBookmarkShellCommand" />
      <ToolbarItem id="ClearBookmarks" tooltip="Clear Bookmarks" icon="ClearBookmark_16x" class="UnoDevelop.Commands.ClearBookmarksShellCommand" />
    </Condition>
  </Path>
</AddIn>
