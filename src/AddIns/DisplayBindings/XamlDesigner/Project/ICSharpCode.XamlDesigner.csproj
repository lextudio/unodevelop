<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <RootNamespace>ICSharpCode.XamlDesigner</RootNamespace>
    <AssemblyName>ICSharpCode.XamlDesigner</AssemblyName>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Main\Core\Project\ICSharpCode.Core.csproj" />
    <ProjectReference Include="..\..\..\..\Main\Base\Project\ICSharpCode.SharpDevelop.csproj" />
    <ProjectReference Include="..\..\..\..\..\UnoPropertyGrid\src\UnoPropertyGrid\UnoPropertyGrid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="XamlDesigner.addin" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Configuration\AssemblyInfo.cs" />
    <Compile Include="Src\XamlDesignerDisplayBinding.cs" />
    <Compile Include="Src\XamlDesignerViewContent.cs" />
    <Compile Include="Src\XamlToolboxProvider.cs" />
    <Compile Include="Src\XamlOutlineContentHost.cs" />
  </ItemGroup>
</Project>
