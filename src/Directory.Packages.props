<Project>
  <ItemGroup>
    <!-- Pin patched Tmds.DBus.Protocol to avoid GHSA-xrw6-gwf8-vvr9 (CVE-2026-39959) -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.2" />
    <PackageVersion Include="GitVersion.MsBuild" Version="5.12.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageVersion Include="LeXtudio.DevFlow.Agent.Uno" Version="0.1.14" />
    <PackageVersion Include="LeXtudio.Windows" Version="0.8.9" />
    <PackageVersion Include="LeXtudio.UnoDock" Version="0.1.12" />
    <PackageVersion Include="LeXtudio.UnoDock.Themes.VS2013" Version="0.1.12" />
    <PackageVersion Include="LeXtudio.UnoEdit" Version="0.7.8" />
    <PackageVersion Include="LeXtudio.UnoPropertyGrid" Version="0.4.2" />
    <PackageVersion Include="Microsoft.Build" Version="18.7.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="5.3.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Validation" Version="17.8.8" />
    <PackageVersion Include="System.CodeDom" Version="10.0.9" />
    <!-- Real MIT VS MEF: engine (Microsoft.VisualStudio.Composition) + standard MEF2 attributes
         (System.Composition.AttributedModel). See docs/project-system.md (Slice 44). -->
    <PackageVersion Include="Microsoft.VisualStudio.Composition" Version="17.13.41" />
    <PackageVersion Include="System.Composition.AttributedModel" Version="8.0.0" />
    <PackageVersion Include="System.Composition.Runtime" Version="8.0.0" />
    <!-- MEF2 hosting/typed-part discovery for docs/language-services.md §8.3
         (CSharpVBLanguageService.CodeActions.cs) - composes CodeFixProvider exports from the
         same assembly set Roslyn's own Workspace uses (MefHostServices.DefaultAssemblies).
         Pinned to 9.0.0, not 8.0.0 like the sibling System.Composition.AttributedModel/Runtime
         above, to match what Microsoft.CodeAnalysis.CSharp.Features 5.3.0 and
         Microsoft.VisualStudio.Composition 17.13.41 already pull in transitively (NU1605
         package-downgrade error otherwise). -->
    <PackageVersion Include="System.Composition.Hosting" Version="9.0.0" />
    <PackageVersion Include="System.Composition.TypedParts" Version="9.0.0" />
    <!-- Pin patched MessagePack (transitive via Microsoft.VisualStudio.Composition 17.13.41 ->
         2.5.192) to avoid several known advisories, e.g. GHSA-vh6j-jc39-fggf. Same 2.x line as
         upstream's pin, so no VS MEF compatibility risk. -->
    <PackageVersion Include="MessagePack" Version="2.5.302" />
    <!-- LSP client transport for docs/language-services.md slice 5 (LspLanguageService). -->
    <PackageVersion Include="StreamJsonRpc" Version="2.21.10" />
    <!-- NuGet.Client engine for docs/nuget-manager.md slice 1 (real NuGet.Client, not the
         MonoDevelop-vendored copy). Pulls in NuGet.Commands/Resolver/Protocol/Configuration/
         Frameworks/Packaging/ProjectManagement transitively. -->
    <PackageVersion Include="NuGet.PackageManagement" Version="7.6.0" />
    <!-- T4 (Text Template Transformation Toolkit) engine from Mono.TextTemplating
         (the open-source extract of Microsoft's T4 engine, used by both SharpDevelop
         and MonoDevelop). Version 3.0.0 matches the upstream SharpDevelop reference. -->
    <PackageVersion Include="Mono.TextTemplating" Version="3.0.0" />
    <!-- Code coverage instrumentation/runner used by the Analysis/CodeCoverage addin. -->
    <PackageVersion Include="coverlet.console" Version="6.0.4" />
    <!-- File/project template engine for docs/template-system.md slice 1 — the same engine
         `dotnet new` and modern Visual Studio use, not SharpDevelop's/MonoDevelop's own
         proprietary template formats. -->
    <PackageVersion Include="Microsoft.TemplateEngine.Abstractions" Version="10.0.301" />
    <PackageVersion Include="Microsoft.TemplateEngine.Edge" Version="10.0.301" />
    <PackageVersion Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" Version="10.0.301" />
    <PackageVersion Include="Microsoft.TemplateEngine.Utils" Version="10.0.301" />
    <!-- The actual IDE-facing entry point (Bootstrapper) — wraps EngineEnvironmentSettings +
         default component registration so built-in .NET SDK templates are discoverable without
         hand-wiring providers/generators ourselves. -->
    <PackageVersion Include="Microsoft.TemplateEngine.IDE" Version="10.0.301" />
  </ItemGroup>
</Project>
