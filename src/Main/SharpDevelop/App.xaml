<Application
    x:Class="UnoDevelop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:swc="using:System.Windows.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- LeXtudio.Windows' WPF-compat controls (ToggleButton, DataGrid, ...) declare
                     their styles/templates in Themes/Generic.xaml, relying on WinUI's automatic
                     per-assembly Generic.xaml discovery for DefaultStyleKey resolution. That
                     discovery doesn't reliably trigger for controls that are constructed purely
                     in code and added to a purely code-constructed parent (e.g. the toolbar
                     builder's ToggleButton instances) rather than declared in a XAML tree -
                     OnApplyTemplate never fires, so Checked/Unchecked visuals never appear even
                     though IsChecked itself flips correctly. Merging it explicitly here guarantees
                     the styles are found via the normal resource-lookup path regardless. -->
                <ResourceDictionary Source="ms-appx:///LeXtudio.Windows/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="swc:ToolBar">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
