<Page
    x:Class="UnoDevelop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dock="using:AvalonDock"
    xmlns:dockLayout="using:AvalonDock.Layout"
    xmlns:dockThemes="using:UnoDock.Themes.VS2013"
    xmlns:swc="using:System.Windows.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
        <MenuBar x:Name="MainMenu"
                 Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                 BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                 BorderThickness="0,0,0,1">
            <MenuBarItem x:Name="FileMenu"
                         Title="File" />
            <MenuBarItem x:Name="EditMenu"
                         Title="Edit" />
            <MenuBarItem x:Name="ViewMenu"
                         Title="View" />
            <MenuBarItem x:Name="ProjectMenu"
                         Title="Project" />
            <MenuBarItem x:Name="BuildMenu"
                         Title="Build" />
            <MenuBarItem x:Name="DebugMenu"
                         Title="Debug" />
            <MenuBarItem x:Name="SearchMenu"
                         Title="Search" />
            <MenuBarItem x:Name="ToolsMenu"
                         Title="Tools" />
            <MenuBarItem x:Name="WindowMenu"
                         Title="Window" />
            <MenuBarItem x:Name="HelpMenu"
                         Title="Help" />
        </MenuBar>

        <swc:ToolBar x:Name="MainToolbar" />
    </StackPanel>

        <dock:DockingManager Grid.Row="1"
                         x:Uid="MainPage.DockManager"
                         x:Name="DockManager">
        <dock:DockingManager.Theme>
            <dockThemes:Vs2013LightTheme />
        </dock:DockingManager.Theme>
        <dock:DockingManager.Layout>
            <dockLayout:LayoutRoot>
                <dockLayout:LayoutPanel Orientation="Horizontal">
                    <dockLayout:LayoutAnchorablePane x:Name="LeftPane" DockWidth="280" />

                    <dockLayout:LayoutPanel Orientation="Vertical">
                        <dockLayout:LayoutDocumentPane x:Name="DocumentPane" />
                        <dockLayout:LayoutAnchorablePane x:Name="BottomPane"
                                                          DockHeight="180" />
                    </dockLayout:LayoutPanel>

                    <dockLayout:LayoutAnchorablePane x:Name="RightPane" DockWidth="300" />
                </dockLayout:LayoutPanel>
            </dockLayout:LayoutRoot>
        </dock:DockingManager.Layout>
        </dock:DockingManager>

        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,6,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ShellStatusText"
                           Opacity="0.72"
                           VerticalAlignment="Center"
                           Text="Ready" />
                <TextBlock x:Name="ShellTaskNameText"
                           Grid.Column="1"
                           Opacity="0.72"
                           VerticalAlignment="Center"
                           Margin="12,0,12,0" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ProgressBar x:Name="ShellProgressBar"
                                 Minimum="0"
                                 Maximum="1"
                                 Height="4"
                                 Width="72"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed" />
                    <!-- Shown only while the running operation opted in to cancellation
                         (IStatusBarService.CreateCancellableProgressMonitor), so a long task like
                         MTP test discovery can be abandoned instead of waiting it out. -->
                    <Button x:Name="ShellProgressCancelButton"
                            AutomationProperties.AutomationId="ShellProgressCancelButton"
                            Content="Cancel"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Click="OnShellProgressCancelClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
