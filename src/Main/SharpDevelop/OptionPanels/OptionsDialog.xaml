<ContentDialog
    x:Class="UnoDevelop.OptionPanels.OptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Options"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    PrimaryButtonClick="OnPrimaryButtonClick">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">600</x:Double>
  </ContentDialog.Resources>

  <Grid Width="580" Height="400">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ListView x:Name="_panelList"
              Grid.Column="0"
              SelectionMode="Single"
              SelectionChanged="OnPanelSelectionChanged" />

    <Rectangle Grid.Column="1"
               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

    <ContentPresenter x:Name="_contentArea"
                      Grid.Column="2"
                      Margin="12,4" />
  </Grid>
</ContentDialog>
