			<TextTemplatingPublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\Misc\TextTemplating\Project\bin\$(Configuration)\net10.0-desktop\UnoDevelop.TextTemplating.*" Exclude="**\*.addin" />
			<PackageManagementPublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\Misc\PackageManagement\Project\bin\$(Configuration)\net10.0-desktop\UnoDevelop.PackageManagement.*" Exclude="**\*.addin" />
			<SearchAndReplacePublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\Misc\SearchAndReplace\Project\bin\$(Configuration)\net10.0-desktop\UnoDevelop.SearchAndReplace.*" Exclude="**\*.addin" />
			<StartPagePublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\Misc\StartPage\Project\bin\$(Configuration)\net10.0-desktop\UnoDevelop.StartPage.*" Exclude="**\*.addin" />
			<XmlEditorPublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\DisplayBindings\XmlEditor\Project\bin\$(Configuration)\net10.0-desktop\UnoDevelop.XmlEditor.*" Exclude="**\*.addin" />
			<IconEditorPublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\DisplayBindings\IconEditor\Project\bin\$(Configuration)\net10.0-desktop\UnoDevelop.IconEditor.*" Exclude="**\*.addin" />
			<GitAddInPublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\VersionControl\GitAddIn\Project\bin\$(Configuration)\net10.0-desktop\UnoDevelop.GitAddIn.*" Exclude="**\*.addin" />
			<XamlDesignerPublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\DisplayBindings\XamlDesigner\Project\bin\$(Configuration)\net10.0-desktop\ICSharpCode.XamlDesigner.*" Exclude="**\*.addin" />
			<FSharpBindingPublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\BackendBindings\FSharpBinding\Project\bin\$(Configuration)\net10.0-desktop\FSharpBinding.*" Exclude="**\*.addin" />
			<AndroidDeviceManagerPublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\Misc\AndroidDeviceManager\Project\bin\$(Configuration)\net10.0-desktop\UnoDevelop.AndroidDeviceManager.*" Exclude="**\*.addin" />
			<AndroidSdkManagerPublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\Misc\AndroidSdkManager\Project\bin\$(Configuration)\net10.0-desktop\UnoDevelop.AndroidSdkManager.*" Exclude="**\*.addin" />
			<UnitTestingPublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\Analysis\UnitTesting\bin\$(Configuration)\net10.0-desktop\UnoDevelop.UnitTesting.*" Exclude="**\*.addin" />
		</ItemGroup>
