	<!-- Remove duplicate .addin files (from AddIn project CopyToOutputDirectory) under bin/ subdirectories -->
	<Target Name="CleanDuplicateAddInFiles" AfterTargets="CopyAddInAssembliesToOutput">
		<ItemGroup>
			<_DupAddIns Include="$(OutputPath)AddIns\**\bin\**\*.addin" />
			<_DupAddIns Include="$(OutputPath)*.addin" />
		</ItemGroup>
		<Delete Files="@(_DupAddIns)" />
	</Target>

	<!-- dotnet publish computes its own file set (ResolvedFileToPublish) rather than xcopying
	     $(OutputPath) - none of the 16 AddIn assemblies CopyAddInAssembliesToOutput places there
	     (AfterTargets="Build") make it into a published/packaged build, so every one of those
	     AddIns silently fails to load (FileNotFoundException on its own .addin-declared DLL) the
	     moment the app is published/installed instead of run via `dotnet run`/`dotnet build`.
	     Mirror the same copies into $(PublishDir). -->
	<Target Name="CopyAddInAssembliesToPublishOutput" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
		<ItemGroup>
			<AddInScoutPublishOutput Include="$(MSBuildThisFileDirectory)..\..\AddIns\Misc\AddinScout\Project\bin\$(Configuration)\net10.0-desktop\UnoDevelop.AddInScout.*" Exclude="**\*.addin" />
