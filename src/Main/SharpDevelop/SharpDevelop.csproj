	<!-- SharpDbg debug adapter: build from submodule, copy output to Debugger/ -->
	<PropertyGroup>
		<SharpDbgProject>$(MSBuildThisFileDirectory)..\..\..\externals\OpenDevelop\externals\sharpdbg\src\SharpDbg.Cli\SharpDbg.Cli.csproj</SharpDbgProject>
		<SharpDbgBinDir>$(MSBuildThisFileDirectory)..\..\..\externals\OpenDevelop\externals\sharpdbg\artifacts\bin\SharpDbg.Cli\$([System.String]::Copy('$(Configuration)').ToLower())\</SharpDbgBinDir>
	</PropertyGroup>

	<Target Name="BuildSharpDbg" BeforeTargets="Build"
	        Condition="!Exists('$(SharpDbgBinDir)SharpDbg.Cli.dll')">
		<Exec Command="dotnet build &quot;$(SharpDbgProject)&quot; -c $(Configuration) -tl:off"
		      ConsoleToMSBuild="true"
		      IgnoreExitCode="false" />
	</Target>

	<Target Name="CopySharpDbgToOutput" AfterTargets="Build">
		<ItemGroup>
			<SharpDbgFiles Include="$(SharpDbgBinDir)**\*.*" />
		</ItemGroup>
		<MakeDir Directories="$(OutputPath)Debugger\" />
		<Copy SourceFiles="@(SharpDbgFiles)"
		      DestinationFolder="$(OutputPath)Debugger\%(RecursiveDir)"
		      SkipUnchangedFiles="true" />
	</Target>

	<!-- dotnet publish computes its own file set (ResolvedFileToPublish) rather than xcopying
	     $(OutputPath) - files dropped there by AfterTargets="Build" Copy tasks (like the one
	     above) never make it into the publish output. Mirror the same copy again, this time
	     into $(PublishDir), so a packaged/published app still finds SharpDbg. -->
	<Target Name="CopySharpDbgToPublishOutput" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
		<ItemGroup>
			<SharpDbgPublishFiles Include="$(SharpDbgBinDir)**\*.*" />
		</ItemGroup>
		<MakeDir Directories="$(PublishDir)Debugger\" />
		<Copy SourceFiles="@(SharpDbgPublishFiles)"
		      DestinationFolder="$(PublishDir)Debugger\%(RecursiveDir)"
		      SkipUnchangedFiles="true" />
	</Target>

