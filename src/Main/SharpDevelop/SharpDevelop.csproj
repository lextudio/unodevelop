		         Link="Upstream\Workbench\DisplayBinding\DisplayBindingService.cs" />
		<Compile Include="$(SharpDevelopSourceRoot)\src\Main\Base\Project\Project\Build\MultipleProjectBuildable.cs"
		         Link="Upstream\Project\Build\MultipleProjectBuildable.cs" />
		<!-- Shared DAP transport/session (Debugger.AddIn's DapClient/DapSession/DapModels) - see
		     doc/technotes/debugging.md. DebugService.cs wraps DapSession instead of talking to the
		     adapter process directly, so both hosts share one Content-Length framing implementation
		     and one launch/attach/capability-negotiation protocol layer. -->
		<Compile Include="$(SharpDevelopSourceRoot)\src\AddIns\Debugger\Debugger.AddIn\Service\Dap\DapClient.cs"
		         Link="Upstream\Debugger\Dap\DapClient.cs" />
		<Compile Include="$(SharpDevelopSourceRoot)\src\AddIns\Debugger\Debugger.AddIn\Service\Dap\DapSession.cs"
		         Link="Upstream\Debugger\Dap\DapSession.cs" />
		<Compile Include="$(SharpDevelopSourceRoot)\src\AddIns\Debugger\Debugger.AddIn\Service\Dap\DapModels.cs"
		         Link="Upstream\Debugger\Dap\DapModels.cs" />
		<!-- Shared Project Browser node model (see doc/technotes/solution-explorer.md) - the
		     framework-agnostic node context/properties/model classes, canonically named
		     ProjectBrowser* to match OpenDevelop's own running pad. WPF-specific rendering
		     (ProjectBrowserNodeModel.Wpf.cs) is NOT linked here - UnoDevelop computes its own
		     icons/overlays in its WinUI tree converter instead. -->
		<Compile Include="$(SharpDevelopSourceRoot)\src\Main\SharpDevelop\Services\ProjectBrowserNodeContext.cs"
		         Link="Upstream\Services\ProjectBrowserNodeContext.cs" />
		<Compile Include="$(SharpDevelopSourceRoot)\src\Main\SharpDevelop\Services\ProjectBrowserNodeProperties.cs"
		         Link="Upstream\Services\ProjectBrowserNodeProperties.cs" />
		<Compile Include="$(SharpDevelopSourceRoot)\src\Main\SharpDevelop\Services\ProjectBrowserNodeModel.cs"
		         Link="Upstream\Services\ProjectBrowserNodeModel.cs" />
		<!-- Framework-agnostic MSBuild-item -> display-item resolution (see
		     doc/technotes/solution-explorer.md); UnoProjectService.GetProjectDisplayItems(IProject)
		     used to duplicate this, now deleted in favor of the shared implementation. -->
		<Compile Include="$(SharpDevelopSourceRoot)\src\Main\SharpDevelop\Services\ProjectDisplayItems.cs"
		         Link="Upstream\Services\ProjectDisplayItems.cs" />
		<!-- Shared Project Browser command/business-logic layer - see
		     doc/technotes/solution-explorer.md. Only native dialog/clipboard calls stay per-host,
		     in this project's own ProjectBrowserController.cs. -->
		<Compile Include="$(SharpDevelopSourceRoot)\src\Main\SharpDevelop\Services\ProjectBrowserControllerBase.cs"
		         Link="Upstream\Services\ProjectBrowserControllerBase.cs" />
		<Compile Include="$(SharpDevelopSourceRoot)\src\Main\SharpDevelop\Services\ProjectBrowserTreeKindResolver.cs"
		         Link="Upstream\Services\ProjectBrowserTreeKindResolver.cs" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Icons\*.svg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="AddIns\**\*.addin">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>AddIns\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>
		<Content Include="..\..\AddIns\**\*.addin">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>AddIns\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="data\layouts\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>data\layouts\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Templates\Bundled\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>Templates\Bundled\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>
