		<MakeDir Directories="$(PublishDir)AddIns\Misc\RegExpTk\Project\" />
		<MakeDir Directories="$(PublishDir)AddIns\DisplayBindings\SettingsEditor\Project\" />
		<MakeDir Directories="$(PublishDir)AddIns\DisplayBindings\HexEditor\Project\" />
		<MakeDir Directories="$(PublishDir)AddIns\Analysis\CodeCoverage\Project\" />
		<MakeDir Directories="$(PublishDir)AddIns\Analysis\CodeCoverage\Project\AltCover\" />
		<MakeDir Directories="$(PublishDir)AddIns\Misc\TextTemplating\Project\" />
		<MakeDir Directories="$(PublishDir)AddIns\Misc\PackageManagement\Project\" />
		<MakeDir Directories="$(PublishDir)AddIns\Misc\SearchAndReplace\Project\" />
		<MakeDir Directories="$(PublishDir)AddIns\Misc\StartPage\Project\" />
