<ContentDialog
    x:Class="UnoDevelop.Templates.NewProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New Project"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">500</x:Double>
  </ContentDialog.Resources>

  <Grid Width="550" Height="560">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox
        x:Name="NameBox"
        Grid.Row="0"
        PlaceholderText="Project name"
        TextChanged="OnNameChanged"
        Margin="0,0,0,4" />

    <TextBox
        x:Name="LocationBox"
        Grid.Row="1"
        PlaceholderText="Location"
        TextChanged="OnLocationChanged"
        Margin="0,0,0,8"
        Height="32"
        VerticalAlignment="Top" />

    <ListView
        x:Name="TemplateList"
        Grid.Row="2"
        SelectionMode="Single"
        SelectionChanged="OnSelectionChanged"
        Margin="0,0,0,8">
      <ListView.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" Foreground="Gray"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <TextBox
        x:Name="ParametersBox"
        Grid.Row="3"
        Header="Template parameters (optional, one per line: key=value)"
        AcceptsReturn="True"
        TextWrapping="Wrap"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
        PlaceholderText="Framework=net10.0"
        Margin="0,0,0,8"
        MinHeight="84"
        MaxHeight="120" />

    <TextBlock
        x:Name="StatusText"
        Grid.Row="4"
        Foreground="Gray" />
  </Grid>
</ContentDialog>
