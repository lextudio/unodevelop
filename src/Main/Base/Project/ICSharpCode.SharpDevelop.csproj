    <PackageReference Include="Microsoft.TemplateEngine.Edge" />
    <PackageReference Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" />
    <PackageReference Include="Microsoft.TemplateEngine.Utils" />
    <PackageReference Include="Microsoft.TemplateEngine.IDE" />
  </ItemGroup>
  <ItemGroup Condition=" '$(UseNuGetPackages)' == 'true' ">
    <PackageReference Include="LeXtudio.UnoEdit" />
  </ItemGroup>
  <ItemGroup Condition=" '$(UseNuGetPackages)' != 'true' ">
    <ProjectReference Include="..\..\..\..\..\UnoEdit\src\UnoEdit\UnoEdit.csproj" />
  </ItemGroup>

