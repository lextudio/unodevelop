    <ProjectReference Include="..\..\..\Libraries\ResourceFiles\LeXtudio.OpenDevelop.ResourceFiles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime assets excluded: MSBuildEnvironmentInitializer registers Microsoft.Build.Locator
         at app startup, which redirects Microsoft.Build.* assembly resolution to the real
         installed .NET SDK's own copies - shipping this package's own copies in our bin dir would
         just create a second, conflicting set (and re-introduce the MSB0001 "type could not be
         loaded" allowlist mismatch this setup exists to avoid). Compile-time reference only. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" />
    <PackageReference Include="System.Composition.Hosting" />
